# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side).
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Google Maps API Key (Client-side)
VITE_GOOGLE_MAPS_PLATFORM_KEY=""

# Firebase Configuration (Client-side optional overrides)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_OAUTH_CLIENT_ID=""

# Feature Flags
# Set VITE_ENABLE_AI_CONSULTANT=true to enable AI Assistant UI button in dev/preview, or false to hide it in public builds.
VITE_ENABLE_AI_CONSULTANT="false"
